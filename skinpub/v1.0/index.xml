<?xml version="1.0" encoding="utf-8"?>
<skin>
  <information>
    <name>Blog J 모래바다</name>
    <version>1.0</version>
    <description><![CDATA[Blog J 모래바다 — 따라오는 차례 · 제목 번호 · 장 나누기 · 반응형. 무료로 쓰고 고쳐 쓸 수 있으며, 맨 아래 「Skin by Blog J」 표시는 지우지 않아야 합니다. 그대로 다시 나눠 주거나 팔 수 없습니다.]]></description>
    <license><![CDATA[무료 사용 · 고쳐 쓰기 가능 / 다시 배포 · 판매 금지 / 크레딧 유지]]></license>
  </information>
  <author>
    <name><![CDATA[Blog J]]></name>
    <homepage>https://luvbong.tistory.com/</homepage>
    <email></email>
  </author>
  <default>
    <recentEntries>5</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>5</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>30</tagsInCloud>
    <sortInCloud>3</sortInCloud>
    <expandComment>0</expandComment>
    <lengthOfRecentNotice>30</lengthOfRecentNotice>
    <lengthOfRecentEntry>30</lengthOfRecentEntry>
    <lengthOfRecentComment>30</lengthOfRecentComment>
    <lengthOfRecentTrackback>30</lengthOfRecentTrackback>
    <lengthOfLink>30</lengthOfLink>
    <entriesOnPage>10</entriesOnPage>
    <entriesOnList>10</entriesOnList>
    <expandTrackback>0</expandTrackback>
    <showListOnCategory>1</showListOnCategory>
    <showListOnArchive>1</showListOnArchive>
    <commentMessage>
      <none>댓글이 없습니다.</none>
      <single>댓글 &lt;span class="cnt"&gt;하나&lt;/span&gt;</single>
    </commentMessage>
    <trackbackMessage>
      <none>받은 트랙백이 없습니다.</none>
      <single>트랙백 &lt;span class="cnt"&gt;하나&lt;/span&gt;</single>
    </trackbackMessage>
    <tree>
      <color>14202b</color>
      <bgColor>faf6ee</bgColor>
      <activeColor>0e7c86</activeColor>
      <activeBgColor>e6f4f5</activeBgColor>
      <labelLength>27</labelLength>
      <showValue>1</showValue>
    </tree>
    <contentWidth>1080</contentWidth>
    <liststyle>auto</liststyle>
    <cover><![CDATA[[{"name": "featured", "title": "", "dataType": "RECENT", "data": {"category": "ALL", "size": 5}}, {"name": "grid", "title": "최신 글", "dataType": "RECENT", "data": {"category": "ALL", "size": 6}}]]]></cover>
  </default>
  <cover>
    <item>
      <name>featured</name>
      <label><![CDATA[큰 글 + 목록]]></label>
      <description><![CDATA[첫 글을 크게, 나머지는 옆에 목록으로]]></description>
    </item>
    <item>
      <name>list</name>
      <label><![CDATA[사진 목록]]></label>
      <description><![CDATA[왼쪽 사진 + 제목 · 요약]]></description>
    </item>
    <item>
      <name>grid</name>
      <label><![CDATA[카드 3칸]]></label>
      <description><![CDATA[사진 카드 격자]]></description>
    </item>
    <item>
      <name>gallery</name>
      <label><![CDATA[사진 갤러리]]></label>
      <description><![CDATA[사진만 크게, 제목은 사진 위에]]></description>
    </item>
    <item>
      <name>titles</name>
      <label><![CDATA[제목 목록]]></label>
      <description><![CDATA[제목 · 날짜만 가볍게]]></description>
    </item>
    <item>
      <name>banner</name>
      <label><![CDATA[배너(직접 입력)]]></label>
      <description><![CDATA[「직접 입력」으로 그림 · 문구 · 링크를 넣는 큰 띠]]></description>
    </item>
  </cover>
  <liststyle>
    <item>
      <label><![CDATA[스킨 설정대로]]></label>
      <value>auto</value>
    </item>
    <item>
      <label><![CDATA[사진 목록]]></label>
      <value>thumb</value>
    </item>
    <item>
      <label><![CDATA[카드]]></label>
      <value>card</value>
    </item>
    <item>
      <label><![CDATA[제목 목록]]></label>
      <value>title</value>
    </item>
    <item>
      <label><![CDATA[잡지]]></label>
      <value>zine</value>
    </item>
    <item>
      <label><![CDATA[번호 목록]]></label>
      <value>magazine</value>
    </item>
  </liststyle>
  <variables>
    <variablegroup name="기본">
      <variable>
        <name>bj-logo-img</name>
        <label><![CDATA[로고 그림]]></label>
        <description><![CDATA[제목 앞에 높이 36px로 보입니다. 비우면 블로그 제목만]]></description>
        <type>IMAGE</type>
      </variable>
      <variable>
        <name>bj-logo-sub</name>
        <label><![CDATA[로고 아래 한 줄]]></label>
        <description><![CDATA[블로그 제목 아래 작은 글씨. 비우면 숨김]]></description>
        <type>STRING</type>
      </variable>
    </variablegroup>
    <variablegroup name="모양">
      <variable>
        <name>bj-palette</name>
        <label><![CDATA[색 묶음]]></label>
        <description><![CDATA[]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "sea", "label": "모래 · 바다", "value": "sea"}, {"name": "forest", "label": "숲", "value": "forest"}, {"name": "navy", "label": "남색", "value": "navy"}, {"name": "ink", "label": "먹(흑백)", "value": "ink"}, {"name": "blossom", "label": "벚꽃", "value": "blossom"}, {"name": "custom", "label": "직접 고르기(아래 색)", "value": "custom"}]]]></option>
        <default><![CDATA[sea]]></default>
      </variable>
      <variable>
        <name>bj-color</name>
        <label><![CDATA[주 색(색 묶음 「직접 고르기」일 때)]]></label>
        <description><![CDATA[단추 · 링크 · 강조에 쓰는 색. 진한 색 · 옅은 색은 이 색에서 저절로 만듭니다]]></description>
        <type>COLOR</type>
        <default><![CDATA[#0e7c86]]></default>
      </variable>
      <variable>
        <name>bj-font</name>
        <label><![CDATA[글꼴]]></label>
        <description><![CDATA[]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "pretendard", "label": "프리텐다드", "value": "pretendard"}, {"name": "nanumgothic", "label": "나눔고딕", "value": "nanumgothic"}, {"name": "gowun", "label": "고운돋움", "value": "gowun"}, {"name": "myeongjo", "label": "나눔명조", "value": "myeongjo"}]]]></option>
        <default><![CDATA[pretendard]]></default>
      </variable>
      <variable>
        <name>bj-width</name>
        <label><![CDATA[본문 너비]]></label>
        <description><![CDATA[]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "narrow", "label": "좁게", "value": "narrow"}, {"name": "normal", "label": "보통", "value": "normal"}, {"name": "wide", "label": "넓게", "value": "wide"}, {"name": "xwide", "label": "아주 넓게", "value": "xwide"}]]]></option>
        <default><![CDATA[normal]]></default>
      </variable>
      <variable>
        <name>bj-list</name>
        <label><![CDATA[글 목록 모양]]></label>
        <description><![CDATA[카테고리 · 검색 · 태그 목록]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "thumb", "label": "사진 목록", "value": "thumb"}, {"name": "card", "label": "카드", "value": "card"}, {"name": "title", "label": "제목 목록", "value": "title"}, {"name": "zine", "label": "잡지(큰 사진 글 + 격자)", "value": "zine"}, {"name": "magazine", "label": "번호 목록(01 · 02 + 오른쪽 사진)", "value": "magazine"}]]]></option>
        <default><![CDATA[thumb]]></default>
      </variable>
      <variable>
        <name>bj-recent-thumb</name>
        <label><![CDATA[최근 글 사진]]></label>
        <description><![CDATA[사이드바(바닥 칸 포함) 「최근 글」 목록 앞 작은 사진]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "show", "label": "보이기", "value": "show"}, {"name": "hide", "label": "숨기기(제목만)", "value": "hide"}]]]></option>
        <default><![CDATA[show]]></default>
      </variable>
      <variable>
        <name>bj-sidebar</name>
        <label><![CDATA[사이드바 위치]]></label>
        <description><![CDATA[아래 = 사이드바 전체가 바닥 색 띠 안으로. 몇 개만 보내려면 꾸미기 › 사이드바에서 「바닥」 칸으로 옮기세요. 오른쪽 · 왼쪽은 휴대폰에서 본문 아래로 갑니다]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "right", "label": "오른쪽", "value": "right"}, {"name": "left", "label": "왼쪽", "value": "left"}, {"name": "bottom", "label": "아래(바닥 색 띠 안)", "value": "bottom"}, {"name": "none", "label": "없음", "value": "none"}]]]></option>
        <default><![CDATA[right]]></default>
      </variable>
    </variablegroup>
    <variablegroup name="글 화면">
      <variable>
        <name>bj-toc</name>
        <label><![CDATA[따라오는 차례]]></label>
        <description><![CDATA[제목1이 2개 이상인 글]]></description>
        <type>BOOL</type>
        <default><![CDATA[true]]></default>
      </variable>
      <variable>
        <name>bj-num</name>
        <label><![CDATA[제목 번호(02 / 05 · 01)]]></label>
        <description><![CDATA[]]></description>
        <type>BOOL</type>
        <default><![CDATA[true]]></default>
      </variable>
      <variable>
        <name>bj-sheets</name>
        <label><![CDATA[제목1마다 종이 한 장으로 나누기]]></label>
        <description><![CDATA[]]></description>
        <type>BOOL</type>
        <default><![CDATA[true]]></default>
      </variable>
      <variable>
        <name>bj-related</name>
        <label><![CDATA[글 아래 「같은 분류 다른 글」(스킨)]]></label>
        <description><![CDATA[티스토리 플러그인 「카테고리 글 더 보기」를 쓰면 끄세요(두 번 나옴)]]></description>
        <type>BOOL</type>
        <default><![CDATA[false]]></default>
      </variable>
      <variable>
        <name>bj-punch</name>
        <label><![CDATA[종이에 타공 노트 무늬(구멍 · 여백선 · 쪽 번호)]]></label>
        <description><![CDATA[장 나누기를 켰을 때만]]></description>
        <type>BOOL</type>
      </variable>
    </variablegroup>
    <variablegroup name="바닥">
      <variable>
        <name>bj-foot-logo</name>
        <label><![CDATA[바닥 로고]]></label>
        <description><![CDATA[]]></description>
        <type>SELECT</type>
        <option><![CDATA[[{"name": "none", "label": "없음", "value": "none"}, {"name": "same", "label": "머리 로고와 같게", "value": "same"}, {"name": "own", "label": "바닥용 그림(아래)", "value": "own"}]]]></option>
        <default><![CDATA[none]]></default>
      </variable>
      <variable>
        <name>bj-foot-logo-img</name>
        <label><![CDATA[바닥용 로고 그림]]></label>
        <description><![CDATA[바닥이 어두운 색이라 흰 글씨 로고를 따로 올릴 때]]></description>
        <type>IMAGE</type>
      </variable>
      <variable>
        <name>bj-foot-text</name>
        <label><![CDATA[바닥 문구]]></label>
        <description><![CDATA[예: 문의는 방명록으로. 비우면 숨김]]></description>
        <type>STRING</type>
      </variable>
    </variablegroup>
    <variablegroup name="윗띠">
      <variable>
        <name>bj-band-text</name>
        <label><![CDATA[윗띠 이름]]></label>
        <description><![CDATA[머리 위 가는 띠의 앞 글자(예: 안내). 비우면 띠 전체를 숨김]]></description>
        <type>STRING</type>
      </variable>
      <variable>
        <name>bj-band-l1-text</name>
        <label><![CDATA[링크 1 글자]]></label>
        <description><![CDATA[]]></description>
        <type>STRING</type>
      </variable>
      <variable>
        <name>bj-band-l1-url</name>
        <label><![CDATA[링크 1 주소]]></label>
        <description><![CDATA[]]></description>
        <type>STRING</type>
      </variable>
      <variable>
        <name>bj-band-l2-text</name>
        <label><![CDATA[링크 2 글자]]></label>
        <description><![CDATA[]]></description>
        <type>STRING</type>
      </variable>
      <variable>
        <name>bj-band-l2-url</name>
        <label><![CDATA[링크 2 주소]]></label>
        <description><![CDATA[]]></description>
        <type>STRING</type>
      </variable>
    </variablegroup>
  </variables>
</skin>
